{
  "schemaVersion": 1,
  "id": "feedback",
  "revision": 1,
  "title": "Share feedback",
  "description": "Multiple selections, a slider, and a conditional field.",
  "sections": [
    {
      "id": "experience",
      "title": "Your experience",
      "fields": [
        {
          "id": "rating",
          "type": "slider",
          "label": "Overall rating",
          "required": false,
          "defaultValue": 4,
          "validation": {
            "min": 1,
            "max": 5,
            "step": 1
          }
        },
        {
          "id": "highlights",
          "type": "multiSelect",
          "label": "What worked well?",
          "required": false,
          "defaultValue": [],
          "options": [
            {
              "value": "speed",
              "label": "Speed"
            },
            {
              "value": "design",
              "label": "Design"
            },
            {
              "value": "ease",
              "label": "Ease of use"
            }
          ]
        },
        {
          "id": "followUp",
          "type": "toggle",
          "label": "May we contact you?",
          "required": false,
          "defaultValue": false
        },
        {
          "id": "email",
          "type": "email",
          "label": "Contact email",
          "required": true,
          "visibleWhen": {
            "fieldId": "followUp",
            "equals": true
          }
        },
        {
          "id": "comments",
          "type": "multilineText",
          "label": "Anything else?",
          "required": false,
          "validation": {
            "maxLength": 1000
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "preview",
      "type": "preview",
      "title": "Review answers"
    }
  ]
}
